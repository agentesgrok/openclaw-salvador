# ─── Servidor ───
PORT=3456
NODE_ENV=production
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# ─── Auth dos endpoints REST /api/* (Bearer) — gere com: openssl rand -hex 32 ───
# (WEBHOOK_CRM_SECRET é o nome antigo e ainda é aceito como fallback)
API_SECRET=

# ─── LLM proxy OpenAI-compatible (/v1) — consumido pelo OpenClaw (provider mythos) ───
# Bearer do /v1 (fallback: API_SECRET). Use um valor diferente do API_SECRET.
LLM_PROXY_API_KEY=
LLM_PROXY_MODELS=claude-sonnet-5,claude-opus-4-8,claude-opus-4-7
LLM_PROXY_DEFAULT_MODEL=claude-sonnet-5
# > 1 para o CLI executar tools (MCP) dentro do turno
LLM_PROXY_MAX_TURNS=12
LLM_PROXY_TIMEOUT_MS=300000

# ─── Claude Code CLI (spawn em claude-query.js) ───
# Binário Node usado pro spawn do CLI (ex: /opt/node/bin/node)
CLAUDE_NODE_BIN=node
CLAUDE_DEFAULT_PERMISSION_MODE=acceptEdits
QUERY_TIMEOUT=120000
MAX_CLAUDE_PROCESSES=2
MEMORY_THROTTLE_PERCENT=85

# ─── MCP no agente (via llm-proxy) — ver MCP-NO-AGENTE.md ───
# JSON de servers MCP (--mcp-config + --strict-mcp-config). Aceita ${VAR} no env dos servers.
LLM_PROXY_MCP_CONFIG=mcp-servers.json
# Allowlist real de tools: built-ins ("Read") e/ou MCP ("mcp__<server>__<tool>"), separadas por vírgula
LLM_PROXY_ALLOWED_TOOLS=
# Texto livre anexado ao aviso de ferramentas (orientação ao modelo, não trava)
# LLM_PROXY_TOOLS_GUIDANCE=
# Credenciais referenciadas por ${VAR} no mcp-servers.json
GUIMOO_API_KEY=
