# Config da rotina semanal de update (deploy/openclaw-update.sh).
# Copie para ~/.config/openclaw-update.env (fora do repo) e ajuste.

# Número E.164 que recebe o aviso de cada execução pelo WhatsApp (vazio = só log).
NOTIFY_TO=+5521996196614

# Só instala versões publicadas há pelo menos N dias (--now ignora).
MIN_AGE_DAYS=7

# Quantos backups pré-update manter em BACKUP_DIR (o da execução atual nunca é apagado).
KEEP_BACKUPS=6

# Onde ficam backups, logs das execuções e last-run.json.
BACKUP_DIR=$HOME/.openclaw-backups

# Quantas vezes repetir o e2e quando ele sai com 2 (inconclusivo: slot do CLI ocupado), com 120 s entre tentativas.
E2E_RETRIES=3

# Deadline por passo do `openclaw update` (segundos).
UPDATE_TIMEOUT=900

# Atualizar também o @anthropic-ai/claude-code do mythos com o mesmo portão (1) ou não (0).
UPDATE_MYTHOS=1
